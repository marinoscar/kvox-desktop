{
  "name": "kvox-desktop",
  "productName": "KVox",
  "version": "0.0.1",
  "private": true,
  "description": "KVox Desktop: single-user, offline-first meeting notes and a personal knowledge graph. A host of the @marinoscar/kvox-* packages.",
  "license": "MIT",
  "author": "Oscar Marin",
  "main": "out/main/index.js",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "prepare:db": "node scripts/prepare-db.mjs",
    "vendor:kvox": "node scripts/vendor-kvox-packages.mjs",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "dev": "npm run prepare:db && electron-vite dev",
    "build": "npm run prepare:db && electron-vite build",
    "test": "vitest run",
    "e2e": "playwright test",
    "dist": "npm run build && node scripts/dist.mjs --publish never",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.10",
    "@electric-sql/pglite-pgvector": "0.0.11",
    "@electric-sql/pglite-socket": "0.2.13",
    "@fastify/multipart": "^10.0.0",
    "@marinoscar/kvox-api": "file:vendor/kvox/marinoscar-kvox-api-0.0.0.tgz",
    "@marinoscar/kvox-contract": "file:vendor/kvox/marinoscar-kvox-contract-0.0.0.tgz",
    "@marinoscar/kvox-db": "file:vendor/kvox/marinoscar-kvox-db-0.0.0.tgz",
    "@marinoscar/platform-db": "0.1.0-next.5",
    "@nestjs/common": "^11.1.12",
    "@nestjs/core": "^11.1.12",
    "@nestjs/platform-fastify": "^11.1.12",
    "@nestjs/swagger": "^11.2.5",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@prisma/client-runtime-utils": "^7.8.0",
    "electron-updater": "6.8.9",
    "fastify": "^5.0.0",
    "nestjs-zod": "^5.4.0",
    "pg": "^8.23.0",
    "prisma": "^7.8.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "undici": "^7.30.1",
    "unpdf": "^1.9.0",
    "yauzl": "^3.4.0",
    "yazl": "^3.3.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@electron/fuses": "1.8.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@marinoscar/kvox-web": "file:vendor/kvox/marinoscar-kvox-web-0.0.0.tgz",
    "@mui/icons-material": "^9.1.0",
    "@mui/material": "^9.1.0",
    "@playwright/test": "^1.64.1",
    "@swc/core": "^1.15.0",
    "@tanstack/react-virtual": "^3.14.12",
    "@tiptap/core": "^3.31.3",
    "@tiptap/extension-table": "^3.31.3",
    "@tiptap/markdown": "^3.31.3",
    "@tiptap/pm": "^3.31.3",
    "@tiptap/react": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "@types/emscripten": "^1.41.5",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/semver": "^7.8.0",
    "@types/yauzl": "^3.4.0",
    "@types/yazl": "^3.3.1",
    "@vitejs/plugin-react": "^6.0.2",
    "electron": "44.9.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.17.0",
    "remark-gfm": "^4.0.1",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "fastify": "$fastify"
  },
  "scarfSettings": {
    "enabled": false
  }
}
